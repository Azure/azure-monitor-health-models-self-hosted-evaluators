<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SelfHostedEvaluators.$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>SelfHostedEvaluators.$(MSBuildProjectName)</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
